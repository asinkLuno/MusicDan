musicdan.syncmoon.ink {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin

    handle /latest.json {
        root * /srv/musicdan/public
        rewrite * /latest/release.json
        header Cache-Control "no-store"
        file_server
    }

    handle /releases.json {
        root * /srv/musicdan/public
        header Cache-Control "no-store"
        file_server
    }

    handle /releases/* {
        root * /srv/musicdan/public
        @apk path *.apk
        header @apk Content-Type application/vnd.android.package-archive
        header @apk Content-Disposition attachment
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv/musicdan/site
        @assets path /assets/*
        @entry not path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        header @entry Cache-Control "no-cache"
        file_server
    }
}
