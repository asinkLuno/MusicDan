musicdan.syncmoon.ink {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin

    handle /latest.json {
        root * /srv/musicdan/public
        rewrite * /latest/release.json
        header Cache-Control "no-store"
        file_server
    }

    handle /releases.json {
        root * /srv/musicdan/public
        header Cache-Control "no-store"
        file_server
    }

    handle /releases/* {
        root * /srv/musicdan/public
        # latest.apk 符号链接随版本切换，不能缓存；文件名不随链接泄露版本，
        # 由官网下载按钮的 download 属性给出带版本的文件名
        @latestapk path /releases/latest.apk
        header @latestapk Content-Type application/vnd.android.package-archive
        header @latestapk Content-Disposition "attachment; filename=MusicDan_latest_arm64.apk"
        header @latestapk Cache-Control "no-store"
        @latestsum path /releases/latest.apk.sha256
        header @latestsum Cache-Control "no-store"
        @apk {
            path *.apk
            not path /releases/latest.apk
        }
        header @apk Content-Type application/vnd.android.package-archive
        header @apk Content-Disposition attachment
        header @apk Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv/musicdan/site
        @assets path /assets/*
        @entry not path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        header @entry Cache-Control "no-cache"
        file_server
    }
}
