[Unit]
Description=Mirror verified MusicDan GitHub Release APKs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=musicdan
Group=musicdan
ExecStart=/usr/bin/python3 /opt/musicdan/sync-releases.py
TimeoutStartSec=15min
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/musicdan

