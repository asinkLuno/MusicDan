#!/usr/bin/env bash
# 推送 releases 分支即发布：本地完成测试、签名构建 APK、GitHub Release 与官网部署
# （scripts/release.mjs）。失败会中止推送；重复执行幂等。
# 其他克隆需要启用钩子：git config core.hooksPath .githooks
set -euo pipefail
zero=0000000000000000000000000000000000000000
target=
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/releases" ] && [ "$local_sha" != "$zero" ]; then
    target=$local_sha
  fi
done
if [ -n "$target" ]; then
  exec node "$(cd -- "$(dirname -- "$0")" && pwd)/../scripts/release.mjs" --pushed-sha "$target"
fi
exit 0
