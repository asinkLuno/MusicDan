{
  "name": "musicdan",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "yarn quality && tsc --noEmit && vite build",
    "tauri": "tauri",
    "fixtures:refresh": "node scripts/refresh-ncm-fixture.mjs",
    "fixtures:add-version": "node scripts/add-ncm-version.mjs",
    "fixtures:refresh-lyrics": "node scripts/refresh-ncm-lyrics.mjs",
    "screenshots:release": "node scripts/capture-release.mjs",
    "build:release-site": "node scripts/build-release-site.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "yarn lint && yarn format:check",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.80.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "latest"
  }
